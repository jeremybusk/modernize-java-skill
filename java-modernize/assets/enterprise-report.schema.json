{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Java Modernize enterprise report",
  "description": "Report shape. The bundled helper adds cross-field gates; neither establishes the truth of supplied evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "status",
    "generated_at",
    "baseline",
    "policy",
    "freshness",
    "modules",
    "components",
    "checks",
    "artifacts",
    "constraints",
    "limitations",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "audit",
        "upgrade-java",
        "maintain-java",
        "modernize-code"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "dirty",
        "description"
      ],
      "properties": {
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            {
              "type": "null"
            }
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "require_supported_updates",
        "evidence_max_age_days"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "require_supported_updates": {
          "type": "boolean"
        },
        "evidence_max_age_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "freshness": {
      "enum": [
        "verified",
        "partial",
        "unverified"
      ]
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "before",
          "after",
          "preserve"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "before": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "build_jvm",
              "compiler_jdk",
              "compilation_target",
              "test_jvm",
              "deployment_runtime"
            ],
            "properties": {
              "build_jvm": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "compiler_jdk": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "compilation_target": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "test_jvm": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "deployment_runtime": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              }
            }
          },
          "after": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "build_jvm",
              "compiler_jdk",
              "compilation_target",
              "test_jvm",
              "deployment_runtime"
            ],
            "properties": {
              "build_jvm": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "compiler_jdk": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "compilation_target": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "test_jvm": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "deployment_runtime": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              }
            }
          },
          "preserve": {
            "type": "array",
            "items": {
              "enum": [
                "build_jvm",
                "compiler_jdk",
                "compilation_target",
                "test_jvm",
                "deployment_runtime"
              ]
            },
            "minItems": 0
          },
          "targets": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "build_jvm": {
                "type": "integer",
                "minimum": 1
              },
              "compiler_jdk": {
                "type": "integer",
                "minimum": 1
              },
              "compilation_target": {
                "type": "integer",
                "minimum": 1
              },
              "test_jvm": {
                "type": "integer",
                "minimum": 1
              },
              "deployment_runtime": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "minItems": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "minItems": 0
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 5000
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 5000
      },
      "minItems": 0
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 5000
      },
      "minItems": 0
    },
    "inputs_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_at",
        "files",
        "graphs"
      ],
      "properties": {
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "files": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 50000,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "graphs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module",
              "artifact_ids"
            ],
            "properties": {
              "module": {
                "type": "string",
                "minLength": 1
              },
              "artifact_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "description": "Project-relative POSIX path. Helper rejects absolute paths, traversal and backslashes."
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "checked_at"
      ],
      "properties": {
        "kind": {
          "enum": [
            "publication",
            "compatibility",
            "availability",
            "support",
            "security"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "current",
        "selected",
        "action",
        "compatibility",
        "availability",
        "support",
        "reason",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "current": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            {
              "type": "null"
            }
          ]
        },
        "selected": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "enum": [
            "update",
            "keep",
            "defer"
          ]
        },
        "compatibility": {
          "enum": [
            "verified",
            "unverified",
            "incompatible"
          ]
        },
        "availability": {
          "enum": [
            "available",
            "unverified",
            "unavailable"
          ]
        },
        "support": {
          "enum": [
            "supported",
            "unverified",
            "unsupported"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "required",
        "status",
        "command",
        "environment",
        "reason",
        "artifact_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "kind": {
          "enum": [
            "baseline",
            "build",
            "unit-tests",
            "integration-tests",
            "api",
            "contract",
            "startup",
            "security",
            "performance",
            "other"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run",
            "not_applicable"
          ]
        },
        "command": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            {
              "type": "null"
            }
          ]
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "minItems": 0
        },
        "tests_before": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tests_after": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tests_change_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
