{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Java modernization project policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "mode",
    "evidence_max_age_days",
    "require_supported_updates",
    "input_scope",
    "modules",
    "components",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "mode": {
      "enum": [
        "upgrade-java",
        "maintain-java",
        "modernize-code"
      ]
    },
    "evidence_max_age_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "require_supported_updates": {
      "type": "boolean"
    },
    "input_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "excluded_dirs",
        "rationale"
      ],
      "properties": {
        "excluded_dirs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "targets",
          "preserve"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "targets": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "build_jvm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "compiler_jdk": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "compilation_target": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "test_jvm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "deployment_runtime": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            }
          },
          "preserve": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "build_jvm",
                "compiler_jdk",
                "compilation_target",
                "test_jvm",
                "deployment_runtime"
              ]
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "allowed_actions",
          "selected_versions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "allowed_actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "update",
                "keep",
                "defer"
              ]
            }
          },
          "selected_versions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "allowed_statuses"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "kind": {
            "enum": [
              "baseline",
              "build",
              "unit-tests",
              "integration-tests",
              "api",
              "contract",
              "startup",
              "security",
              "performance",
              "other"
            ]
          },
          "allowed_statuses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "passed",
                "not_applicable"
              ]
            }
          }
        }
      }
    }
  }
}
